# Copia a `.env.local`. Nunca subas secretos.

# --- Desarrollo local ---
NEXT_PUBLIC_PLAYNOTES_API_ORIGIN=http://localhost:3000
# PLAYNOTES_API_ORIGIN=http://localhost:3000
INDIE_SOUL_FEST_REDIRECT_URI=http://127.0.0.1:4310/oauth/callback
INDIE_SOUL_FEST_COOKIE_SECURE=false
NEXT_PUBLIC_CATALOG_ORIGIN=http://127.0.0.1:4310
NEXT_PUBLIC_LANDING_DOMAIN=indiesoulfest.com

